{
  "name": "valorant-auto-predictions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "dev:api": "tsx watch src/index.ts",
    "build": "npm run clean && npm run build:web && npm run build:server && node scripts/copy-web.mjs",
    "clean": "node scripts/clean.mjs",
    "build:web": "npm run build --prefix web",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:web": "npm test --prefix web"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
