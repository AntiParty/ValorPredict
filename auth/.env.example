# Copy to .env.local for `npm run dev:local`. In production, set these in the Vercel
# project settings (mark the three secrets as "Sensitive"). Never commit real values.

# From https://dev.twitch.tv/console/apps  (Client Type: Confidential)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public origin of THIS deployment, no trailing slash, no path.
# Must match an OAuth Redirect URL registered on the Twitch app: <PUBLIC_BASE_URL>/api/callback
# http is only accepted for localhost. For local testing use http://localhost:3001
PUBLIC_BASE_URL=https://auth.example.com

# 32 random bytes, base64. Generate each one separately (works on Windows too):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CODE_SEAL_KEY=
STATE_SIGNING_KEY=
